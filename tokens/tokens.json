  "theme": {
    "$extensions": {
      "com.figma": {
        "modes": [
          "Light",
          "Dark"
        ]
      }
    },
    "background": {
      "$value": {
        "Light": "{primitives.white}",
        "Dark": "{primitives.navy.800}"
      },
      "$type": "color",
      "$extensions": {
        "com.figma": {
          "scopes": [
            "FRAME_FILL",
            "SHAPE_FILL"
          ],
          "codeSyntax": {
            "WEB": "var(--background)"
          }
        }
      }
    },
    "foreground": {
